# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# AWS S3 storage and optional CloudFront delivery
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_CLOUDFRONT_DOMAIN=your-distribution.cloudfront.net

# Google AI for development text and image generation
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key

# Optional Vertex AI configuration for reference image analysis
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1
# Local path to a service-account JSON file; keep the file out of Git.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
