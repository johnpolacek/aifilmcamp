{
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenes"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "scenes": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "sceneOrdinal", "synopsis", "entities", "states", "events", "relationships"],
        "properties": {
          "sceneId": { "type": "string" },
          "sceneOrdinal": { "type": "integer" },
          "synopsis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidenceQuote", "confidence"],
            "properties": {
              "text": { "type": "string" },
              "evidenceQuote": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "entities": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "name", "aliasesInScene", "role", "description", "evidenceQuote", "confidence"],
              "properties": {
                "kind": { "type": "string", "enum": ["character", "location", "prop", "vehicle", "creature", "object"] },
                "name": { "type": "string" },
                "aliasesInScene": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
                "role": { "type": "string", "enum": ["speaking", "present", "mentioned", "setting", "used"] },
                "description": { "type": "string" },
                "evidenceQuote": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "states": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entityName", "category", "description", "evidenceQuote", "confidence"],
              "properties": {
                "entityName": { "type": "string" },
                "category": { "type": "string", "enum": ["wardrobe", "hair", "makeup", "injury", "age", "condition", "possession", "time_of_day", "weather", "lighting", "damage", "other"] },
                "description": { "type": "string" },
                "evidenceQuote": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "events": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["entityName", "description", "evidenceQuote", "confidence"],
              "properties": {
                "entityName": { "type": ["string", "null"] },
                "description": { "type": "string" },
                "evidenceQuote": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "relationships": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fromEntityName", "toEntityName", "kind", "description", "evidenceQuote", "confidence"],
              "properties": {
                "fromEntityName": { "type": "string" },
                "toEntityName": { "type": "string" },
                "kind": { "type": "string", "enum": ["family", "romantic", "professional", "adversarial", "possession", "other"] },
                "description": { "type": "string" },
                "evidenceQuote": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
